

const int sensorPin = A0;
const int pwmPin    = 9;

// -------- USER SETTINGS --------


int   setpoint = 500;     // target sensor value (0–1023)

int   maxPWM   = 120;     // safety limit (0–255)

float Kp = 0.4;
float Ki = 0.0005;
float Kd = 15.0;

// -------- INTERNAL STATE --------
float integral  = 0.0;
float lastError = 0.0;
unsigned long lastTime = 0;

void setup() {
  Serial.begin(9600);
  pinMode(pwmPin, OUTPUT);

  analogWrite(pwmPin, 0);     
  lastTime = millis();

  Serial.println("MagLev controller started.");

}

void loop() {
  // ----- Read sensor -----
  int sensor = analogRead(sensorPin);   

  // ----- Time step -----
  unsigned long now = millis();
  float dt = (now - lastTime) / 1000.0;
  if (dt <= 0) dt = 0.001;
  lastTime = now;

  // ----- Error direction -----
 
  float error = (float)setpoint - (float)sensor;


  // ----- PID terms -----
  integral += error * dt;
  if (integral > 1000)  integral = 1000;
  if (integral < -1000) integral = -1000;

  float derivative = (error - lastError) / dt;
  lastError = error;

  float output = Kp * error + Ki * integral + Kd * derivative;

  // ----- Convert to PWM (0–255), with safety clamp -----
  int pwm = (int)output;
  if (pwm < 0)      pwm = 0;
  if (pwm > maxPWM) pwm = maxPWM;

  analogWrite(pwmPin, pwm);

  // ----- Debug output -----
  Serial.print("Sensor: ");
  Serial.print(sensor);
  Serial.print("  Setpoint: ");
  Serial.print(setpoint);
  Serial.print("  PWM: ");
  Serial.print(pwm);
  Serial.print("  Error: ");
  Serial.println(error);

  delay(5);  
}
